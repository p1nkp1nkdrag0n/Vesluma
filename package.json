{
  "name": "vesluma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "maps:boundaries": "node scripts/import-city-boundaries.mjs",
    "maps:plan": "node scripts/build-city-plans.mjs",
    "maps:skeleton": "node scripts/import-map-skeleton.mjs",
    "native:sync": "npm run build && cap sync",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.55.0",
    "@types/leaflet": "^1.9.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "polygon-clipping": "^0.15.7",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
